@page "/add-job"
@page "/edit-job/{Id:guid}"
@using JobTracker.App.Domain;
@using JobTracker.App.Features.JobApplications;
@using JobTracker.App.Features.Settings;
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IJobTrackerService JobTrackerService;
@inject IJobOriginService JobOriginService;
@inject NavigationManager NavManager;
@inject IJSRuntime JS;

<div class="container mt-4 mb-5">
    <h3>Nueva Postulación</h3>

    <EditForm Model="application" OnValidSubmit="HandleSubmit">
        
        <div class="mb-3">
            <label>Empresa:</label>
            <InputText class="form-control" @bind-Value="application.CompanyName" required />
        </div>

        <div class="mb-3">
            <label>Puesto (Job Title):</label>
            <InputText class="form-control" @bind-Value="application.JobTitle" required />
        </div>

        <div class="mb-3">
            <label>URL de la oferta (Opcional):</label>
            <InputText class="form-control" @bind-Value="application.JobUrl" />
        </div>

        <div class="mb-3">
            <label>Salario Esperado (Opcional):</label>
            <InputNumber class="form-control" @bind-Value="application.ExpectedSalary" />
        </div>

        <div class="mb-3">
            <label>Notas (Opcional):</label>
            <InputTextArea class="form-control" @bind-Value="application.Notes" />
        </div>

        <div class="mb-3">
            <label>Fecha de Postulación:</label>
            <InputDate class="form-control" @bind-Value="application.ApplicationDate" required />
        </div>

        <div class="mb-3">
            <label>Origen (Plataforma):</label>
            <InputSelect class="form-control" @bind-Value="application.OriginId">
                <option value="0">Seleccione un origen...</option>
                @foreach (var origin in jobOrigins)
                {
                    <option value="@origin.Id">@origin.Name</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label>Estado de la Postulación:</label>
            <InputSelect class="form-control" @bind-Value="application.Status">
                @foreach (var status in Enum.GetValues<ApplicationStatus>())
                {
                    <option value="@status">@status.ToString()</option>
                }
            </InputSelect>
        </div>

        <!-- Cambiamos el texto del botón dinámicamente -->
        <button type="submit" class="btn btn-primary w-100">
            @(Id.HasValue ? "Actualizar Postulación" : "Guardar Postulación")
        </button>
    </EditForm>
</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private JobApplication application = new JobApplication { ApplicationDate = DateTime.Today };
    private List<JobOrigin> jobOrigins = new();

    protected override async Task OnInitializedAsync()
    {
        // 1. Cargamos los orígenes siempre
        jobOrigins = await JobOriginService.GetJobOriginsAsync();

        // 2. Si hay un ID en la URL, estamos en Modo Edición
        if (Id.HasValue)
        {
            var existingApp = await JobTrackerService.GetJobApplicationByIdAsync(Id.Value);
            if (existingApp != null)
            {
                application = existingApp;
            }
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (application.OriginId == 0)
            {
                await JS.InvokeVoidAsync("alert", "Por favor, seleccione un origen válido.");
                return;
            }

            // Modo Nuevo
            if (!Id.HasValue)
            {
                application.Id = Guid.NewGuid();
                // Si el usuario no tocó el estado, forzamos "Pendiente" al crear
                if (application.Status == default)
                    application.Status = ApplicationStatus.Pendiente;

                await JobTrackerService.AddJobApplicationAsync(application);
                await JS.InvokeVoidAsync("alert", "¡Postulación guardada!");
            }
            // Modo Edición
            else
            {
                await JobTrackerService.UpdateJobApplicationAsync(application);
                await JS.InvokeVoidAsync("alert", "¡Postulación actualizada!");
            }

            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Ocurrió un error: {ex.Message}");
        }
    }
}